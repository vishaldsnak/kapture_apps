	/**
	 * @see Filter#doFilter(ServletRequest, ServletResponse, FilterChain)
	 */
	public void doFilter(ServletRequest request, ServletResponse response,
			FilterChain chain) throws IOException, ServletException {
		String wslId = "";
		boolean reDirectToError = false;
		boolean useDefaultUser = false;
		UserAccessBean sessionBean = getSessionBean((HttpServletRequest) request);

		/*
		 * If the container does not put an "iv-user" header on the request (no WebSEAL in
		 * front of the application), inject the user configured as wsl.default.user by
		 * wrapping the request. Everything downstream - this filter, every servlet's
		 * wsl.check block and every JSP - keeps reading the header exactly as before, so no
		 * other class needs to change.
		 */
		String defaultUser = ApplicationProperties.getProperty("wsl.default.user");
		if (null != defaultUser && !"".equals(defaultUser.trim())
				&& null == ((HttpServletRequest) request).getHeader("iv-user")) {
			request = new DefaultUserRequestWrapper((HttpServletRequest) request,
					defaultUser.trim());
			useDefaultUser = true;
		}
		defaultUser = null;

		/*
		 * DIAG - TEMPORARY REQUEST TRACE. Remove once the /mypage -> /noaccess redirect on
		 * MC Dev is understood. Every line is tagged "DIAG" so the whole trace can be
		 * stripped with a single search, and each carries the request URI so the load
		 * balancer's pulse.html traffic can be filtered out ("grep DIAG | grep -v pulse").
		 */
		logger.info("doFilter :: DIAG ENTRY uri {"
				+ ((HttpServletRequest) request).getRequestURI()
				+ "} session {" + ((HttpServletRequest) request).getSession().getId()
				+ "} bean@" + System.identityHashCode(sessionBean)
				+ " ivUserHeader {" + ((HttpServletRequest) request).getHeader("iv-user")
				+ "} useDefaultUser {" + useDefaultUser
				+ "} beanLoggedInUserId {" + sessionBean.getLoggedInUserId()
				+ "} beanModules {"
				+ (null == sessionBean.getUserAllModulesList() ? "NULL"
						: String.valueOf(sessionBean.getUserAllModulesList().size()))
				+ "}");

		try {
			if (null != ((HttpServletRequest) request).getHeader("iv-user")) {
				wslId = (String) ((HttpServletRequest) request)
						.getHeader("iv-user");
			}
//			logger.info("doFilter :: wsl id :: >>"+ wslId);
			msgProps = new MessageProperties(((HttpServletRequest) request)
					.getSession().getAttribute("MDM_LS_Locale"));
			if (null != wslId && !"".equals(wslId)) {
				wslId = wslId.trim().toLowerCase();
				// logger.info("doFilter :: Logged In user is :: > " + wslId);

				// call functionTo Populate Roles List
				getRolesList();

				/*
				 * FETCH THE USER ROLE MAPPED WITH THE USER, ALONG WITH THE
				 * CONTENT LOCALES AND DEFAULT LOCALES. IF USER IS SUPER ADMIN,
				 * THEN POPULATE USER ACCESS LIST WITH ALL THE MODULES HAVING
				 * READ & WRITE ACCESS IF USER IS NOT SUPER ADMIN, THEN FETCH
				 * ROLE BASED ACCESS FOR MODULES FOR THE USER AND SET IN USER
				 * ACCESS LIST
				 */
				boolean rePopulateBean = true;
				if (null != sessionBean.getLoggedInUserId()
						&& !"".equals(sessionBean.getLoggedInUserId())) {
					if (sessionBean.getLoggedInUserId().trim().toLowerCase()
							.equals(wslId.trim().toLowerCase())) {
						rePopulateBean = false;
					}
				}

				// DIAG - TEMPORARY REQUEST TRACE. See ENTRY above.
				logger.info("doFilter :: DIAG DECISION uri {"
						+ ((HttpServletRequest) request).getRequestURI()
						+ "} wslId {" + wslId
						+ "} beanLoggedInUserId {" + sessionBean.getLoggedInUserId()
						+ "} rePopulateBean {" + rePopulateBean + "}");

				if (rePopulateBean == true) {
					// RESET BEAN
					resetBean(sessionBean);

					// update WSL ID in sessionBean
					sessionBean.setLoggedInUserId(wslId);

					/*
					 * INJECTING THE HEADER AND BUILDING THE PROFILE ARE TWO SEPARATE DECISIONS.
					 *
					 * Without WebSEAL in front of the application there is no iv-user header, so
					 * wsl.default.user injects one (see doFilter above). That says nothing about
					 * where the PROFILE should come from. Set
					 * wsl.default.user.kapture.profile=TRUE to inject the header but still read
					 * the profile from Kapture, which is the only way to exercise UserProfileDAO
					 * on a workstation - the hardcoded block below never touches it.
					 *
					 * BOTH PROPERTIES MUST BE BLANK ON VDI AND MC DEV, where the real header
					 * arrives and the real profile is read.
					 */
					boolean useKaptureProfile = "TRUE".equalsIgnoreCase(String.valueOf(
							ApplicationProperties.getProperty("wsl.default.user.kapture.profile")).trim());

					if (useDefaultUser == true && useKaptureProfile == false) {
						/*
						 * DEFAULT (INJECTED) USER - do NOT call InfoManager. Build the
						 * profile from hardcoded values so every functionality is reachable.
						 */
						logger.info("doFilter :: Using hardcoded default user profile for {"
								+ wslId + "}.");
						addDefaultUserProfileDetailsToSessionBean(sessionBean);
					} else {
						if (useDefaultUser == true) {
							logger.info("doFilter :: iv-user was INJECTED for {" + wslId
									+ "}, but wsl.default.user.kapture.profile is TRUE - reading"
									+ " the profile from Kapture, not from the hardcoded block.");
						}
						/*
						 * FETCH USER PROFILE DETAILS FROM KAPTURE.
						 *
						 * WAS: FetchUserProfileImpl.getUserProfileDetailsFromIM(wslId), a SOAP
						 * call to InfoManager returning a UserITO. InfoManager is not deployed
						 * alongside Kapture, so that call cannot succeed on the migrated platform
						 * and every real login would land in the error branch below.
						 *
						 * The gate is unchanged in meaning: a profile with no default locale or
						 * no roles is not usable, and the user goes to error exactly as before.
						 * getDefaultLocale() is checked because the locales block further down
						 * calls replace() on it without a null guard.
						 */
						UserProfileDetails userDetails = UserProfileDAO.getUserProfileFromCMS(wslId);

						if (null != userDetails && null != userDetails.getDefaultLocale()
								&& !"".equals(userDetails.getDefaultLocale().trim()))
						{
							addUserProfileDetailsToSessionBean(sessionBean,userDetails);
						}
						else
						{
							logger.info("doFilter :: Failed to Fetch User Profile Details from Kapture for {"+ wslId + "}. Return to Error.");
							// RESET USER BEAN
							resetBean(sessionBean);
							/*
							 * REDIRECT TO ERROR.
							 */
							reDirectToError = true;
						}
						userDetails = null;
					}
				}
			} else {
				// logger.info("doFilter :: WSL id from Request is null. Return to Error.");

				// RESET USER BEAN
				resetBean(sessionBean);
				/*
				 * REDIRECT TO ERROR.
				 */
				reDirectToError = true;
			}
		} catch (Exception e) {
			Utilities.printStackTraceToLogs(
					AccessManagementFilter.class.getName(), "doFilter()", e);
		}

		if (reDirectToError == true) {
			// ((HttpServletResponse)
			// response).sendRedirect(((HttpServletRequest)request).getContextPath()+"/error");
		}
		/*
		 * DIAG - TEMPORARY REQUEST TRACE. See ENTRY above. This is the LAST thing the filter
		 * knows before the servlet runs, so the module count here is exactly what the servlet
		 * should find on the session bean. reDirectToError is logged because the redirect it
		 * used to trigger is commented out above - when it is TRUE the request continues down
		 * the chain with a bean that resetBean() has just emptied.
		 */
		logger.info("doFilter :: DIAG EXIT uri {"
				+ ((HttpServletRequest) request).getRequestURI()
				+ "} session {" + ((HttpServletRequest) request).getSession().getId()
				+ "} bean@" + System.identityHashCode(sessionBean)
				+ " wslId {" + wslId
				+ "} reDirectToError {" + reDirectToError
				+ "} superAdmin {" + sessionBean.isSuperAdminUser()
				+ "} userAllModulesList {"
				+ (null == sessionBean.getUserAllModulesList() ? "NULL"
						: String.valueOf(sessionBean.getUserAllModulesList().size()))
				+ "}");

		chain.doFilter(request, response);
	}

