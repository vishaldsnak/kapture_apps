	private UserAccessBean getSessionBean(HttpServletRequest request) {
		UserAccessBean sessionBean = null;
		if (null != request.getSession().getAttribute("userAccessBean")
				&& !"".equals(request.getSession().getAttribute(
						"userAccessBean"))) {
			sessionBean = (UserAccessBean) request.getSession().getAttribute(
					"userAccessBean");
		} else {
			// initialize the sessionBean and set it in HTTP Session
			sessionBean = new UserAccessBean();
			request.getSession().setAttribute("userAccessBean", sessionBean);
		}
		return sessionBean;
	}

	private void resetBean(UserAccessBean sessionBean) {
		sessionBean.setDefaultLocale(null);
		sessionBean.setUserDisplayName(null);
		sessionBean.setDefaultModulesList(null);
		sessionBean.setEngineModulesList(null);
		sessionBean.setLoggedInUserId(null);
		sessionBean.setMissionModulesList(null);
		sessionBean.setNormalModulesList(null);
		sessionBean.setSstVehicleTypeModulesList(null);
		sessionBean.setSstMaintenanceModulesList(null);
		sessionBean.setUserLocalesList(null);
		sessionBean.setVehilceTypeModulesList(null);
		sessionBean.setCdCreationModulesList(null);
		sessionBean.setRumVinMappingList(null);
		sessionBean.setTopMenuList(null);
		sessionBean.setDisplayTilesList(null);

		/*
		 * ADD DEFAULT MY PAGE TO TOP MENU
		 */
		ModuleDetails moduleDetails = new ModuleDetails();
		moduleDetails
				.setModuleRefkey(AccessManagementInterface.REF_KEY_DASHBOARD);
		moduleDetails.setModulePath("/mypage");
		moduleDetails.setModuleDisplayName(msgProps.getProperty("label.dash."
				+ moduleDetails.getModuleRefkey()));
		sessionBean.setTopMenuList(new ArrayList<ModuleDetails>());
		sessionBean.getTopMenuList().add(moduleDetails);
		moduleDetails = null;

		sessionBean.setSuperAdminUser(false);
		sessionBean.setMappedRolesList(null);
		sessionBean.setUserAllModulesList(null);
		sessionBean.setDisplayTilesList(null);
	}

	/**
	 * Build the logged-in user profile from HARDCODED values, without contacting
	 * InfoManager. Used when the iv-user header was injected from wsl.default.user
	 * (see doFilter) - typically when the application runs without WebSEAL in front of it.
	 *
	 * Hardcoded profile:
	 *   defaultLocale   = en_US
	 *   contentLocales  = en_US, en_CA, es_MX, fr_CA, ja_JP, en_UK, en_EU
	 *
	 * The mapped role(s) are NOT hardcoded - they come from wsl.default.user.roles (comma
	 * separated), defaulting to DEFAULT_ADMINISTRATION_ROLE. Point that property at a lower
	 * priority role to smoke test the NON super admin path without rebuilding.
	 *
	 * Whether the user is a SUPER ADMIN is likewise NOT hardcoded - it is resolved the production
	 * way by populateModulesForMappedRoles(): each mapped reference key is looked up in the roles
	 * master (gms3_mdm_roles) and the top priority is compared with
	 * AccessManagementInterface.SUPER_ADMIN_ROLE_PRIORITY (1). A super admin gets READ_AND_WRITE on
	 * every module; anyone else gets only what gms3_mdm_roles_access grants their role. The module
	 * lists are then populated by that same shared method, so the real role-fetch and
	 * access-population flow stays under test either way.
	 */
	private void addDefaultUserProfileDetailsToSessionBean(UserAccessBean sessionBean) {
		try {
			// DISPLAY NAME
			sessionBean.setUserDisplayName(ApplicationProperties.getProperty("wsl.default.user"));

			// DEFAULT LOCALE
			sessionBean.setDefaultLocale("en_US");

			/*
			 * USER LOCALES - stored with a hyphen (the real path also converts "_" to "-"),
			 * default locale first, then the content locales.
			 */
			sessionBean.setUserLocalesList(new ArrayList<String>());
			String[] defaultLocales = new String[] { "en_US", "en_CA", "es_MX", "fr_CA",
					"ja_JP", "en_UK", "en_EU" };
			for (int a = 0; a < defaultLocales.length; a++) {
				String loc = defaultLocales[a].replace("_", "-");
				if (!sessionBean.getUserLocalesList().contains(loc)) {
					sessionBean.getUserLocalesList().add(loc);
				}
				loc = null;
			}
			defaultLocales = null;

			/*
			 * MAPPED ROLES - configurable so a NON super admin role can be smoke tested without a
			 * rebuild. Comma separated for a user mapped to more than one role, which is what the
			 * real InfoManager profile can return.
			 *
			 * This only chooses WHICH role reference key(s) the injected user carries. Whether
			 * that makes them a super admin is still resolved the production way below.
			 */
			sessionBean.setMappedRolesList(new ArrayList<String>());
			String configuredRoles = ApplicationProperties.getProperty("wsl.default.user.roles");
			if (null != configuredRoles && !"".equals(configuredRoles.trim())) {
				String[] roleKeys = configuredRoles.trim().split(",");
				for (int r = 0; r < roleKeys.length; r++) {
					if (null != roleKeys[r] && !"".equals(roleKeys[r].trim())) {
						sessionBean.getMappedRolesList().add(roleKeys[r].trim());
					}
				}
				roleKeys = null;
			}
			configuredRoles = null;
			if (sessionBean.getMappedRolesList().isEmpty()) {
				// PROPERTY MISSING OR BLANK - KEEP THE ORIGINAL BEHAVIOUR
				sessionBean.getMappedRolesList().add("DEFAULT_ADMINISTRATION_ROLE_KEY");
			}
			logger.info("addDefaultUserProfileDetailsToSessionBean :: Default user mapped roles :: "
					+ sessionBean.getMappedRolesList());

			/*
			 * RESOLVE ACCESS THE PRODUCTION WAY - do NOT hardcode the super-admin flag here.
			 * The shared method matches the mapped role reference key(s) above against the
			 * roles master (gms3_mdm_roles) loaded by getRolesList(), derives the top priority
			 * and, when it equals SUPER_ADMIN_ROLE_PRIORITY, grants READ_AND_WRITE on every
			 * module; otherwise it applies that role's configured access.
			 */
			populateModulesForMappedRoles(sessionBean);
		} catch (Exception e) {
			Utilities.printStackTraceToLogs(AccessManagementFilter.class.getName(),
					"addDefaultUserProfileDetailsToSessionBean()", e);
		}
	}

	/**
	 * Wraps the request so that getHeader("iv-user") returns the configured default user
	 * when the container did not supply that header. Only the iv-user header is overridden;
	 * every other header behaves exactly as before.
	 */
	private static class DefaultUserRequestWrapper extends HttpServletRequestWrapper {

		private static final String IV_USER = "iv-user";
		private String defaultUser = null;

		public DefaultUserRequestWrapper(HttpServletRequest request, String defaultUser) {
			super(request);
			this.defaultUser = defaultUser;
		}

		public String getHeader(String name) {
			if (null != name && IV_USER.equalsIgnoreCase(name)) {
				String value = super.getHeader(name);
				if (null == value || "".equals(value)) {
					return defaultUser;
				}
				return value;
			}
			return super.getHeader(name);
		}

		public java.util.Enumeration<String> getHeaders(String name) {
			if (null != name && IV_USER.equalsIgnoreCase(name)) {
				java.util.Enumeration<String> values = super.getHeaders(name);
				if (null == values || !values.hasMoreElements()) {
					java.util.List<String> injected = new ArrayList<String>();
					injected.add(defaultUser);
					return java.util.Collections.enumeration(injected);
				}
				return values;
			}
			return super.getHeaders(name);
		}

		public java.util.Enumeration<String> getHeaderNames() {
			java.util.List<String> names = new ArrayList<String>();
			java.util.Enumeration<String> existing = super.getHeaderNames();
			boolean hasIvUser = false;
			if (null != existing) {
				while (existing.hasMoreElements()) {
					String n = existing.nextElement();
					names.add(n);
					if (IV_USER.equalsIgnoreCase(n)) {
						hasIvUser = true;
					}
					n = null;
				}
			}
			if (hasIvUser == false) {
				names.add(IV_USER);
			}
			return java.util.Collections.enumeration(names);
		}
	}

	private void addUserProfileDetailsToSessionBean(UserAccessBean sessionBean,
			UserProfileDetails userDetails) {
		try {
			// SET USER DISPLAY NAME
			if (null != userDetails && null != userDetails.getFirstName()
					&& !"".equals(userDetails.getFirstName())) {
				sessionBean.setUserDisplayName(userDetails.getFirstName());
			} else {
				sessionBean.setUserDisplayName("");
			}
			// SET DEFAULT LOCALE
			if (null != userDetails.getDefaultLocale()
					&& !"".equals(userDetails.getDefaultLocale().trim())) {
				sessionBean.setDefaultLocale(userDetails.getDefaultLocale().trim());
			}
			// SET USER LOCALES LIST
			sessionBean.setUserLocalesList(new ArrayList<String>());
			// ADD DEFAULT LOCALE TO LIST
			String defLocale = sessionBean.getDefaultLocale();
			defLocale = defLocale.replace("_", "-");
			sessionBean.getUserLocalesList().add(defLocale);
			defLocale = null;

			// ADD CONTENT LOCALES
			if (null != userDetails.getContentLocales()
					&& userDetails.getContentLocales().size() > 0) {
				for (int a = 0; a < userDetails.getContentLocales().size(); a++) {
					String conLocale = userDetails.getContentLocales().get(a);
					if (null != conLocale && !"".equals(conLocale.trim())) {
						conLocale = conLocale.trim().replace("_", "-");
						boolean addToList = true;
						if (null != sessionBean.getUserLocalesList()
								&& sessionBean.getUserLocalesList().size() > 0) {
							for (int b = 0; b < sessionBean
									.getUserLocalesList().size(); b++) {
								if (conLocale
										.trim()
										.toLowerCase()
										.equals((String) sessionBean
												.getUserLocalesList().get(b)
												.trim().toLowerCase())) {
									addToList = false;
									break;
								}
							}
						}

						if (addToList == true) {
							sessionBean.getUserLocalesList().add(conLocale);
						}
					}
					conLocale = null;
				}
			}

			/*
			 * ADD MAPPED ROLES - THE MDM ONES ONLY.
			 *
			 * Kapture returns every role it has mapped to the user, its own included
			 * (CEC_*, MC_*, MNAO_*, CMS_*, ADMIN__ROLE_KEY). Those are KAuthor's concern, not
			 * MDM's, and MDM deliberately holds no roles-master row for them. Intersecting with
			 * the master here keeps the session bean meaning "the MDM roles this user holds",
			 * which is what it meant when InfoManager supplied it.
			 *
			 * No translation table is involved: the MDM master was renamed to Kapture's exact
			 * spelling - see db/align_mdm_role_refkeys_with_kapture.sql - so this is a plain
			 * comparison and a role added in Kapture needs only a master row, not a code change.
			 */
			sessionBean.setMappedRolesList(new ArrayList<String>());
			ArrayList<String> knownRefKeys = new ArrayList<String>();
			if (null != rolesList) {
				for (int r = 0; r < rolesList.size(); r++) {
					RoleDetails rd = (RoleDetails) rolesList.get(r);
					if (null != rd && null != rd.getRoleRefKey()) {
						knownRefKeys.add(rd.getRoleRefKey());
					}
					rd = null;
				}
			}
			ArrayList<String> mappedRolesList = UserProfileDAO.mdmRolesOnly(userDetails,
					knownRefKeys);
			sessionBean.getMappedRolesList().addAll(mappedRolesList);
			logger.info("addUserProfileDetailsToSessionBean :: Kapture returned "
					+ userDetails.getRoleRefKeys() + ", of which MDM roles are "
					+ mappedRolesList);
			knownRefKeys = null;
			mappedRolesList = null;

			/*
			 * IDENTIFY WHETHER USER IS SUPER ADMIN OR NOT, AND POPULATE THE MODULE LISTS.
			 * Shared with the hardcoded default-user profile - see populateModulesForMappedRoles().
			 */
			populateModulesForMappedRoles(sessionBean);
		} catch (Exception e) {
			Utilities.printStackTraceToLogs(AccessManagementFilter.class.getName(),"addUserProfileDetailsToSessionBean()", e);
		}
	}


	/**
	 * Decide whether the logged-in user is a SUPER ADMIN and populate every module list
	 * (and the dashboard tiles) accordingly.
	 *
	 * Super admin is decided the production way: the mapped role reference keys held on the
	 * session bean are matched against the roles master (gms3_mdm_roles, loaded by
	 * getRolesList()) and the TOP priority - the LEAST value - is compared with
	 * AccessManagementInterface.SUPER_ADMIN_ROLE_PRIORITY (1).
	 *
	 * Called by both addUserProfileDetailsToSessionBean() (InfoManager profile) and
	 * addDefaultUserProfileDetailsToSessionBean() (hardcoded default user), so both go through
	 * exactly the same role-resolution and access-population flow.
	 */
	private void populateModulesForMappedRoles(UserAccessBean sessionBean) {
		try {
			/*
			 * IDENTIFY WHETHER USER IS SUPER ADMIN OR NOT CHECK FOR THE TOP
			 * MOST PRIORITY OF THE ROLES MAPPED WITH LOGGED IN USER IF PRIORITY
			 * = 1, THEN SUPER ADMIN ELSE FETCH ROLE BASED ACCESS WITH TOP
			 * PRIORITY
			 * 
			 * NOTE - HERE TOP PRIORITY IS THE ONE WITH LEAST VALUE
			 */
			if (null != sessionBean.getMappedRolesList() && sessionBean.getMappedRolesList().size() > 0
					&& null != rolesList && rolesList.size() > 0) 
			{
				ArrayList<Integer> userPriorityList = new ArrayList<Integer>();
				for (int a = 0; a < sessionBean.getMappedRolesList().size(); a++) {
					for (int b = 0; b < rolesList.size(); b++) {
						RoleDetails rDetails = (RoleDetails) rolesList.get(b);
						if (((String) sessionBean.getMappedRolesList().get(a)
								.trim().toLowerCase()).equals(rDetails
								.getRoleRefKey().trim().toLowerCase())) {
							userPriorityList.add(rDetails.getPriority());
						}
						rDetails = null;
					}
				}

				int topPriority = 0;
				if (null != userPriorityList && userPriorityList.size() > 0) {
					topPriority = userPriorityList.get(0);
					for (int i : userPriorityList) {
						if (topPriority >= i) {
							topPriority = i;
						}
					}
				}
				
				if (topPriority > 0) {
					sessionBean
							.setUserAllModulesList(new ArrayList<ModuleDetails>());
					sessionBean.setDisplayTilesList(new ArrayList<ModuleDetails>());
					sessionBean
							.setDefaultModulesList(new ArrayList<ModuleDetails>());
					sessionBean
							.setNormalModulesList(new ArrayList<ModuleDetails>());
					sessionBean
							.setEngineModulesList(new ArrayList<ModuleDetails>());
					sessionBean
							.setMissionModulesList(new ArrayList<ModuleDetails>());
					sessionBean
							.setSstMaintenanceModulesList(new ArrayList<ModuleDetails>());
					sessionBean
							.setSstVehicleTypeModulesList(new ArrayList<ModuleDetails>());
					sessionBean
							.setVehilceTypeModulesList(new ArrayList<ModuleDetails>());
					sessionBean
							.setCdCreationModulesList(new ArrayList<ModuleDetails>());
					sessionBean.setRumVinMappingList(new ArrayList<ModuleDetails>());
					// CHECK SUPER ADMIN
					if (topPriority == AccessManagementInterface.SUPER_ADMIN_ROLE_PRIORITY) 
					{
						logger.info("addUserProfileDetailsToSessionBean :: Logged In User is Super Admin.");
						sessionBean.setSuperAdminUser(true);
						// FETCH ALL THE MODULES LIST AND FOR ALL SET ACCESS -
						// READ / WRITE
						ArrayList<ModuleDetails> modulesList = AccessManagementDAO
								.getModuleDetailsList();
						if (null != modulesList && modulesList.size() > 0) {
							for (int c = 0; c < modulesList.size(); c++) {
								ModuleDetails modDetails = (ModuleDetails) modulesList
										.get(c);
								// SET DISPLAY NAME
								modDetails
										.setModuleDisplayName(msgProps.getProperty("label.dash."
												+ modDetails.getModuleRefkey()));
								// SET ACCESS FOR ALL MODULES = READ/WRITE
								modDetails
										.setAccessType(AccessManagementInterface.READ_AND_WRITE_ACCESS);
								// SET TYPE WISE LIST
								if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_DEFAULT) {
									/*
									 * CHECK HERE, IF ACCESS MANAGEMENT THEN DO
									 * NOT ADD IT TO DEFAULT LIST ACCESS
									 * MANAGEMENT CANNOT BE SHOWN AS TILE ON
									 * DASHBOARD
									 */
									if (!modDetails
											.getModuleRefkey()
											.trim()
											.equals(AccessManagementInterface.REF_KEY_ACCESS_MANAGEMENT)) {
										sessionBean.getDefaultModulesList()
												.add(modDetails);
									}
								} else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_NORMAL) {
									sessionBean.getNormalModulesList().add(
											modDetails);
								} else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_ENGINE) {
									sessionBean.getEngineModulesList().add(
											modDetails);
								} else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_TRANSMISSION) {
									sessionBean.getMissionModulesList().add(
											modDetails);
								} else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_SSTMAINTENANCE) {
									sessionBean.getSstMaintenanceModulesList()
											.add(modDetails);
								} else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_SSTVEHICLEDATA) {
									sessionBean.getSstVehicleTypeModulesList()
											.add(modDetails);
								} else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_VEHICLETYPE) {
									sessionBean.getVehilceTypeModulesList()
											.add(modDetails);
								} else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_CDCREATION) {
									sessionBean.getCdCreationModulesList().add(
											modDetails);
								}
								else if(modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_RUMVIN)
								{
									sessionBean.getRumVinMappingList().add(modDetails);
								}

								// ADD TO ALL MODULES LIST AS WELL
								sessionBean.getUserAllModulesList().add(
										modDetails);
								modDetails = null;
							}
						}
						modulesList = null;
					} else {
						logger.info("addUserProfileDetailsToSessionBean :: Logged In User is Not Super Admin.");
						// NOT SUPER ADMIN
						sessionBean.setSuperAdminUser(false);
						
						
						String mnaoLocaleKey=ApplicationProperties.getProperty("en_us").trim()+","+ApplicationProperties.getProperty("en_ca").trim()+","+
								ApplicationProperties.getProperty("es_mx").trim()+","+ApplicationProperties.getProperty("fr_ca").trim();
						mnaoLocaleKey = mnaoLocaleKey.replace("_", "-");
						String[] mnaoLocales = mnaoLocaleKey.split(",");
						String mcLocaleKey = ApplicationProperties.getProperty("ja_jp").trim();
						mcLocaleKey = mcLocaleKey.replace("_", "-");
						String[] mcLocales = mcLocaleKey.split(",");
						String mmeLocaleKey = ApplicationProperties.getProperty("mme.not.writable.locales").trim()+","+ApplicationProperties.getProperty("en_uk").trim();
						mmeLocaleKey = mmeLocaleKey.replace("_", "-");
						String[] mmeLocales = mmeLocaleKey.split(",");

						// IDENTIFY THE REF KEY OF ROLE FOR PRIOROTY AND FETCH
						// USER ACCESS ON THE BASIS OF IT.
						String roleRefKey = "";
						if (null != rolesList && rolesList.size() > 0) {
							for (int r = 0; r < rolesList.size(); r++) {
								RoleDetails rDetails = (RoleDetails) rolesList
										.get(r);
								if (rDetails.getPriority() == topPriority) {
									roleRefKey = rDetails.getRoleRefKey();
									break;
								}
							}
						}
						// FETCH MODULES LIST ON THE BASIS OF ROLE
						ArrayList<ModuleDetails> modulesList = AccessManagementDAO.getExistingAccessDetails("", roleRefKey);
						if (null != modulesList && modulesList.size() > 0) {
							for (int c = 0; c < modulesList.size(); c++) {
								ModuleDetails modDetails = (ModuleDetails) modulesList
										.get(c);
								// SET DISPLAY NAME
								modDetails
										.setModuleDisplayName(msgProps.getProperty("label.dash."
												+ modDetails.getModuleRefkey()));
								boolean addToAll = false;
								// SET TYPE WISE LIST
								if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_NORMAL) 
								{
									/*
									 * APPLICABLE FOR MNAO SI VIN RANGE, MC SIVIN RANGE & MME SI VIN RANGE
									 * IF USER HAS ANY MNAO LOCALE AND HAS ACCESS TO MNAO SI VIN RANGE - SHOW MNAO SI VIN
									 * IF USER HAS ANY MC LOCALE AND HAS ACCESS TO MC SI VIN RANGE - SHOW MC SI VIN
									 * IF USER HAS ANY MME LOCALE AND HAS ACCESS TO MME SI VIN RANGE - SHOW MME SI VIN
									 */
									boolean addToList = false;
									if(null!=modDetails.getModuleRefkey() && !"".equals(modDetails.getModuleRefkey()))
									{
										if(modDetails.getModuleRefkey().trim().toLowerCase().equals(AccessManagementInterface.REF_KEY_MNAO_SIVIN_RANGE.trim().toLowerCase()) || 
												modDetails.getModuleRefkey().trim().toLowerCase().equals(AccessManagementInterface.REF_KEY_MNAO_DATA_EXPORT_TOOL.trim().toLowerCase()) || 
												modDetails.getModuleRefkey().trim().toLowerCase().equals(AccessManagementInterface.REF_KEY_NEW_MNAO_DATA_EXPORT_TOOL.trim().toLowerCase()))
										{
											/*
											 *  USER HAS ACCESS TO MNAO SI VIN RANGE
											 *  DOES HE HAVE MNAO LOCALES ?
											 */
											if(null!=sessionBean.getUserLocalesList() && sessionBean.getUserLocalesList().size()>0 && null!=mnaoLocales && mnaoLocales.length>0)
											{
												for(String userLoc : sessionBean.getUserLocalesList())
												{
													for(int p=0;p<mnaoLocales.length;p++)
													{
														if(userLoc.trim().toLowerCase().equals(mnaoLocales[p].trim().toLowerCase()))
														{
															// USER HAS MNAO LOCALE - ALLOW TO BE ADDED
															addToList=true;
															addToAll = true;
															break;
														}
													}
													userLoc = null;
												}
											}
										}
										else if(modDetails.getModuleRefkey().trim().toLowerCase().equals(AccessManagementInterface.REF_KEY_MC_SIVIN_RANGE.trim().toLowerCase()))
										{
											/*
											 *  USER HAS ACCESS TO MNAO SI VIN RANGE
											 *  DOES HE HAVE MC LOCALES ?
											 */
											if(null!=sessionBean.getUserLocalesList() && sessionBean.getUserLocalesList().size()>0 && null!=mcLocales && mcLocales.length>0)
											{
												for(String userLoc : sessionBean.getUserLocalesList())
												{
													for(int p=0;p<mcLocales.length;p++)
													{
														if(userLoc.trim().toLowerCase().equals(mcLocales[p].trim().toLowerCase()))
														{
															// USER HAS MC LOCALE - ALLOW TO BE ADDED
															addToList=true;
															addToAll = true;
															break;
														}
													}
													userLoc= null;
												}
											}
										}
										else if(modDetails.getModuleRefkey().trim().toLowerCase().equals(AccessManagementInterface.REF_KEY_MME_SIVIN_RANGE.trim().toLowerCase()) || 
												modDetails.getModuleRefkey().trim().toLowerCase().equals(AccessManagementInterface.REF_KEY_SI_TRANSLATION_UPDATE.trim().toLowerCase()))
										{
											/*
											 *  USER HAS ACCESS TO MME SI VIN RANGE / TRANSLATION UPDATE
											 *  DOES HE HAVE MME LOCALES ?
											 */
											if(null!=sessionBean.getUserLocalesList() && sessionBean.getUserLocalesList().size()>0 && null!=mmeLocales && mmeLocales.length>0)
											{
												for(String userLoc : sessionBean.getUserLocalesList())
												{
													for(int p=0;p<mmeLocales.length;p++)
													{
														if(userLoc.trim().toLowerCase().equals(mmeLocales[p].trim().toLowerCase()))
														{
															// USER HAS MME LOCALE - ALLOW TO BE ADDED
															addToList=true;
															addToAll = true;
															break;
														}
													}
													userLoc= null;
												}
											}
										}
										else if(modDetails.getModuleRefkey().trim().toLowerCase().equals(AccessManagementInterface.REF_KEY_RMI_TOOL.trim().toLowerCase()))
										{
											/*
											 * for RMI TOOL - ADD ONLY WHEN
											 * END USER HAS GOT EN_EU LOCALE AND HAS GOT MAPPED MDM distributor Author
											 */
											boolean hasEuropeLocale=false;
											if(null!=sessionBean.getUserLocalesList() && sessionBean.getUserLocalesList().size()>0)
											{
												for(String userLoc : sessionBean.getUserLocalesList())
												{
													if(userLoc.trim().toLowerCase().equals(ApplicationProperties.getProperty("en_eu").replace("_", "-").trim().toLowerCase()))
													{
														// USER HAS EN_EU LOCALE - ALLOW TO BE ADDED
														hasEuropeLocale = true;
														break;
													}
													userLoc= null;
												}
											}
											
											if(hasEuropeLocale==true)
											{
												/*
												 * CHECK FOR SECURITY ROLES MAPPED WITH THE LOGGED IN USER
												 * IF USER AS MDM distributor Author - ALLOW TILE TO BE ADDED
												 */
												if(null!=sessionBean.getMappedRolesList() && sessionBean.getMappedRolesList().size()>0)
												{
													for(String secRole : sessionBean.getMappedRolesList())
													{
														if(secRole.trim().toLowerCase().equals(ApplicationProperties.getProperty("rmitool.MDM_DISTRIBUTOR_AUTHOR.refkey").trim().toLowerCase()))
														{
															// USER HAS MDM_DISTRIBUTOR_AUTHOR ROLE MAPPED - ALLOW THIS TILE TO BE ADDED 
															addToList=true;
															addToAll = true;
															break;
														}
														secRole = null;
													}
												}
											}
										}
										else
										{
											// OTHER NORMAL MODULES - ALLOW THEM TO BE ADDED
											addToList=true;
											addToAll = true;
										}
									}
									
									if(addToList==true)
									{
										sessionBean.getNormalModulesList().add(modDetails);
									}
								}
								else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_ENGINE) 
								{
									sessionBean.getEngineModulesList().add(modDetails);
									addToAll = true;
								} 
								else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_TRANSMISSION) 
								{
									sessionBean.getMissionModulesList().add(modDetails);
									addToAll = true;
								} 
								else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_SSTMAINTENANCE) 
								{
									sessionBean.getSstMaintenanceModulesList().add(modDetails);
									addToAll = true;
								} 
								else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_SSTVEHICLEDATA) 
								{
									sessionBean.getSstVehicleTypeModulesList().add(modDetails);
									addToAll = true;
								} 
								else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_VEHICLETYPE) 
								{
									sessionBean.getVehilceTypeModulesList().add(modDetails);
									addToAll = true;
								} 
								else if (modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_CDCREATION) 
								{
									sessionBean.getCdCreationModulesList().add(modDetails);
									addToAll = true;
								}
								else if(modDetails.getModuleType() == AccessManagementInterface.MODULE_TYPE_RUMVIN)
								{
									sessionBean.getRumVinMappingList().add(modDetails);
									addToAll = true;
								}
								
								if(addToAll==true)
								{
									// ADD TO ALL MODULES LIST AS WELL
									sessionBean.getUserAllModulesList().add(modDetails);
								}
								modDetails = null;
							}
						}
						modulesList = null;
						
						mnaoLocaleKey = null;
						mnaoLocales = null;
						mcLocaleKey = null;
						mcLocales = null;
						mmeLocaleKey = null;
						mmeLocales = null;
					}
					
					/*
					 * CHECK HERE IF USER ALL MODULES LIST IS NOT NULL
					 * SET DISPLAY ORDER TILES LIST - SORT LIST ON THE 
					 * BASIS OF ORDER IN ASCENDING ORDER - 
					 * FOR ENGINE / MISSION / SST SCRRENS / RUM VIN MAPING SCREENS 
					 * ADD ONLY 1 INDEX.
					 * 
					 * DATE 16 - JULY 2018
					 */
					sessionBean.setDisplayTilesList(new ArrayList<ModuleDetails>());
					if(null!=sessionBean.getUserAllModulesList() && sessionBean.getUserAllModulesList().size()>0)
					{
						for(ModuleDetails modDetails : sessionBean.getUserAllModulesList())
						{
							// DO NOT ADD DEFAULT ONE - SETTINGS 
							if (modDetails.getModuleType() != AccessManagementInterface.MODULE_TYPE_DEFAULT) 
							{
								boolean addToList =true;
								if(null!=sessionBean.getDisplayTilesList() && sessionBean.getDisplayTilesList().size()>0)
								{
									for(ModuleDetails existDetils : sessionBean.getDisplayTilesList())
									{
										if(null!=existDetils.getModuleType() && null!=modDetails.getModuleType())
										{
											if(modDetails.getModuleType()!=AccessManagementInterface.MODULE_TYPE_DEFAULT &&  
													modDetails.getModuleType()!=AccessManagementInterface.MODULE_TYPE_NORMAL)
											{
												if(existDetils.getModuleType() == modDetails.getModuleType())
												{
													// MODULE TYPE ALREADY ADDED - DO NTO ADD AGAIN
													addToList = false;
													break;
												}
											}
										}
										existDetils = null;
									}
								}
								
								if(addToList==true)
								{
									sessionBean.getDisplayTilesList().add(modDetails);
								}
							}
							modDetails =  null;
						}
					}
					
					// SORT ON THE BASIS OF DISPLAY ORDER 
					if(null!=sessionBean.getDisplayTilesList() && sessionBean.getDisplayTilesList().size()>0)
					{
						Collections.sort(sessionBean.getDisplayTilesList(), new ModuleComparator());
					}
				}
			}
		} catch (Exception e) {
			Utilities.printStackTraceToLogs(AccessManagementFilter.class.getName(),
					"populateModulesForMappedRoles()", e);
		}
	}

	private void getRolesList() {
		try {
			if (null == rolesList || rolesList.size() <= 0) {
				rolesList = AccessManagementDAO.getAllRoleDetailsList();
			}
		} catch (Exception e) {
			Utilities
					.printStackTraceToLogs(
							AccessManagementFilter.class.getName(),
							"getRolesList()", e);
		}
	}

	public String getActionPath(String requestURI) {
		if (null != requestURI && !"".equals(requestURI)) {
			String[] reqURI = requestURI
					.split("/", requestURI.lastIndexOf("/"));
			if (null != reqURI && reqURI.length > 2) {
				return reqURI[2];
			}
			reqURI = null;
		}
		return null;
	}

}
