# --- Kapture REST API (replaces the InQuira IQ client library) ---
# Used by com.mazda.gms3.mdm.kapture.KaptureApiClient for the SI VIN modify/delete content
# operations. Same endpoints and credentials as the ContentImportJob (Job 9).
kapture.api.base         = https://mgssdev.kapturekm.com
kapture.api.login.path   = /kauthor-api/cms-check
kapture.api.display.path = /kauthor-api/display-Article
# READS GO THROUGH latest-article - IT RESOLVES THE VERSION AND STATE ITSELF AND RETURNS
# BYTE-IDENTICAL CONTENT TO display-Article (verified over master/translation x pub/unpub).
kapture.api.latest.path  = /kauthor-api/latest-article
# TRANSLATIONS ARE WRITTEN HERE, NOT THROUGH update-article-tab, WHICH IS MASTER ONLY.
kapture.api.translate.path = /kauthor-api/save-translate-article
kapture.api.update.path  = /kauthor-api/update-article-tab
# CREATE - the only endpoint that mints a document; used by the SI Data Load screen
kapture.api.create.path  = /kauthor-api/add-article-tab
# Re-publish after updating a PUBLISHED document. Updating a published article writes the change
# into a NEW UNPUBLISHED version, so this promotes that version back to Published. Called ONLY
# when the version being updated was itself Published - an unpublished document stays unpublished.
kapture.api.publish.path = /kauthor-api/publish-article
# Category create / update. kapture_cms_db is READ ONLY to this application, so k_categories is
# never written to directly. Same endpoint names IMCategoryImportJob (Job 4) used to load all 51
# locales, but under /kauthor-api - Job 4's /Kapture-Author context now answers 404 for every
# path. Both were re-confirmed against the live API.
kapture.api.category.create.path = /kauthor-api/add-categoryMgt
kapture.api.category.update.path = /kauthor-api/updateCategoryByCatRef
