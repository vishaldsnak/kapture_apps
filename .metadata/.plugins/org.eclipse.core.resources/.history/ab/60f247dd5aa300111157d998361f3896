# --- MySQL (migrated target) ---
# The connection comes from an application-SCOPED DataSource declared in this
# application's own META-INF/context.xml (WebContent/META-INF/context.xml), NOT from a
# server-wide resource - so the server config is untouched and no other application
# deployed on it is affected. The url / username / password and the JDBC driver class
# live in that context.xml; only the RESOURCE NAMES are configured here.
# Per environment (local / VDI / production) only context.xml changes.
jdbc.datasource=jdbc/conv_datasource
jdbc.im.datasource=jdbc/im_datasource

# --- KAPTURE CMS database (kapture_cms_db) - replaces the Oracle OK_IM schema ---
# A SEPARATE resource is required, not a cross-database reference on jdbc.datasource:
# on VDI kapture_dc and kapture_cms_db sit on the same MySQL server, but on a developer
# workstation kapture_dc is local while kapture_cms_db is the shared AWS server. Where
# they are co-located both resources simply point at the same server.
# All CMS tables are written fully qualified (kapture_cms_db.<table>).
jdbc.cms.datasource=jdbc/cms_datasource

# Values of kapture_cms_db.k_user.user_status that mean the user is ACTIVE.
# Comma separated. Matching is CASE INSENSITIVE and trims surrounding spaces, so listing
# "Active" already accepts "ACTIVE" and "active" - the short form "A" is a genuinely different
# value and does need its own entry. Kapture is not consistent about this: the same environment
# holds "Active" for one user and "ACTIVE" for the next, so an exact match silently treats live
# users as inactive (no notification e-mail, or no profile at login). Blank or missing falls back
# to ACTIVE,A rather than matching nothing, so a typo here cannot lock everyone out.
# Used through Utilities.activeUserStatusPredicate().
kapture.user.active.status=Active,A

# ---------------------------------------------------------------------------
# LOCAL TESTING SWITCH - MUST BE BLANK ON VDI AND MC DEV
# ---------------------------------------------------------------------------
# Reference keys appended to the roles Kapture returns for the logged-in user.
# Comma separated. Kapture has no DEFAULT_ADMINISTRATION_ROLE_KEY yet, so without this
# NO user resolves to MDM Super Admin and the Administration screens cannot be reached.
# This grants nothing on its own: the keys are still intersected with gms3_mdm_roles and
# super-admin is still derived from mdm_role_priority = 1, so a key that is not a real MDM
# role is ignored exactly like a KAuthor one. Every use is logged loudly.
# Blank this the moment Kapture creates and assigns the real super-admin role.
kapture.user.additional.roles=DEFAULT_ADMINISTRATION_ROLE_KEY

# --- Kapture generated document XML ---
# Kapture writes an XML per document version. Layout below the root is
#   <live|staging>/<CHANNEL>/<bucket>/<articleId>/<locale>/<version>/content_<contentid>.xml
# where bucket is a numbered folder FOUND BY SEARCHING for the document, never calculated -
# see KaptureContentXmlReader.bucketFor(). A PUBLISHED document is read from live at its published_version,
# an UNPUBLISHED one from staging at its article_version.
# NOTE the filename is per-CHANNEL, not per-document (all SI docs share one contentid),
# so the FOLDER PATH is what identifies the document - the reader globs content_*.xml.
kapture.content.xml.root=D:/WD/Kapture_WD/Logs_And_Reports/ContentL_Loc/s3Kapture/ROOT/resources/sites/KAPTURE/content

# --- Category label fallback locale, per market ---
# A category row may exist for a reference key but carry no name for the wanted locale.
# MNAO then falls back to en_US, MC uses the selected locale, MME falls back to en_UK.
# en_UK is deliberate and is NOT a typo for en_GB - k_categories carries BOTH as separate
# locales, so "correcting" this to en_GB would silently read the wrong tree.
# The same locale is used as the SOURCE to copy a category hierarchy from when the wanted
# locale has no row at all - see KaptureCategoryServiceImpl.ensureCategoriesForLocale.
# MC has no entry on purpose: it uses the selected locale for both, so there is nothing
# to configure.
kapture.category.label.fallback.mnao=en_US
kapture.category.label.fallback.mme=en_UK
