# LOCAL TESTING SWITCH - MUST BE BLANK ON VDI AND MC DEV.
# Injecting the iv-user header and building the profile are two SEPARATE decisions.
# wsl.default.user above only supplies the header. Set this to TRUE to inject that header
# but still read the PROFILE (display name, default locale, content locales, mapped roles)
# from Kapture through UserProfileDAO - which is the only way to exercise the real profile
# lookup on a workstation, since the hardcoded block below never touches it.
# Blank or anything other than TRUE keeps the old behaviour: injected header AND hardcoded
# profile from wsl.default.user.roles.
wsl.default.user.kapture.profile=TRUE

# Role reference key(s) mapped to that injected user, comma separated for more than one.
# Whether the user ends up a super admin is NOT decided here - the refkey is looked up in
# gms3_mdm_roles and its priority compared with SUPER_ADMIN_ROLE_PRIORITY (1), exactly as in
# production. So changing this value is how a NON super admin role is smoke tested.
# Values present in gms3_mdm_roles. The trailing _KEY is not decoration - these reference keys
# are spelled exactly as Kapture spells them in k_add_user_cmsrole.role_ref, so the real profile
# lookup is a plain equality match with no translation table. See
# db/align_mdm_role_refkeys_with_kapture.sql.
#   DEFAULT_ADMINISTRATION_ROLE_KEY (priority 1 - super admin, sees every module)
#   MDM_MAZDA_ACE_ADMIN_KEY         (priority 2)
#   MDM_DISTRIBUTOR_ADMIN_KEY       (priority 3)
#   MDM_DISTRIBUTOR_AUTHOR_KEY      (priority 4)
#   MDM_MC_CDROM_USER_KEY           (priority 5)
# A non super admin role only sees the modules configured for it in gms3_mdm_roles_access.
# Blank or unknown falls back to DEFAULT_ADMINISTRATION_ROLE_KEY.
wsl.default.user.roles=DEFAULT_ADMINISTRATION_ROLE_KEY


